{
  "name": "@playnt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:setup": "tsx --env-file-if-exists=../../.env scripts/setup-db.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "record": "tsx --env-file-if-exists=../../.env scripts/record.ts",
    "eval": "tsx --env-file-if-exists=../../.env scripts/eval.ts",
    "demo": "tsx --env-file-if-exists=../../.env scripts/demo-server.ts"
  },
  "dependencies": {
    "@playnt/shared": "0.1.0",
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
