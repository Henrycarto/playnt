# Copy to .env. Never commit .env.

# demo replays recorded model responses (no key, no network). gemini calls the model.
TRIAGE_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Docker Compose root user (used by npm run db:setup and npm run seed only)
MONGO_ROOT_USER=playnt_admin
MONGO_ROOT_PASSWORD=change-me-locally
MONGODB_ADMIN_URI=mongodb://playnt_admin:change-me-locally@127.0.0.1:27017/?authSource=admin&directConnection=true

# Least-privilege app user created by npm run db:setup: may append to the audit trail, never change it
MONGODB_APP_USER=playnt_app
MONGODB_APP_PASSWORD=change-me-too
MONGODB_URI=mongodb://playnt_app:change-me-too@127.0.0.1:27017/?authSource=admin&directConnection=true
MONGODB_DB=playnt

PORT=4000
# Demo mode freezes the clock at 2026-10-25 10:00 Vienna unless PLAYNT_NOW is set.
# PLAYNT_NOW=2026-10-25T09:00:00.000Z
